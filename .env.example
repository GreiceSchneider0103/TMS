# Core
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
PORT=3001

# Tiny integration
TINY_BASE_URL=https://api.tiny.com.br
TINY_API_TOKEN=replace_with_tiny_token
TINY_TIMEOUT_MS=15000

# Internal trusted calls (rotate frequently)
INTERNAL_CONTEXT_TOKEN=replace_with_strong_random_token

# CORS (comma-separated exact origins)
CORS_ALLOWED_ORIGINS=https://tms.internal.example.com
CORS_ALLOWED_HEADERS=content-type,x-api-key,x-correlation-id,x-request-id,x-idempotency-key

# Security
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000

# Web session cookie
SESSION_COOKIE_NAME=tms_api_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_DOMAIN=.internal.example.com
SESSION_COOKIE_SECURE=true
